# Claude Code harness runtime state (lock files, local settings)
.claude/

# opencode sibling package — derived mirrors populated by
# scripts/sync-opencode.sh; source of truth lives in plugin/
opencode/.opencode/skills/
opencode/.opencode/agents/
opencode/.opencode/commands/
opencode/.opencode/plugins/hooks/
opencode/.opencode/.claude-plugin/
opencode/node_modules/
opencode/package-lock.json

# rpm session-state (transient, regenerated per session)
docs/rpm/~rpm-*

# playwright MCP browser cache (transient)
.playwright-mcp/
