# rpm-on-Codex sample config fragment.
#
# Codex hooks are behind an experimental feature flag. Merge the block
# below into your `~/.codex/config.toml` so the marketplace plugin hooks
# actually fire.
#
# Without `hooks = true`, Codex will load `hooks.json` but skip
# dispatch silently — the rpm SessionStart context-injection won't
# happen, drift won't be checked, and the Stop-time learnings/handoff
# pipeline won't run.

[features]
hooks = true
