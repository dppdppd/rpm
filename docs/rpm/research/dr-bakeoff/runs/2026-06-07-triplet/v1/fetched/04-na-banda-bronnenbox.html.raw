              <source srcset="/sites/default/files/styles/max_650x650/public/field-media-image/1621%20Banda%202_0.jpg?itok=e_iq7pOC 1x" media="screen and (min-width: 43.75em)" type="image/jpeg" width="465" height="650"/>
              <source srcset="/sites/default/files/styles/max_325x325/public/field-media-image/1621%20Banda%202_0.jpg?itok=gkAE55Z4 1x" media="screen and (min-width: 20em)" type="image/jpeg" width="233" height="325"/>
                  <img loading="eager" width="233" height="325" src="/sites/default/files/styles/max_325x325/public/field-media-image/1621%20Banda%202_0.jpg?itok=gkAE55Z4" alt="Verslag Coen van de gebeurtenissen op Banda  6 mei 1621 (p2)" title="Verslag Coen van de gebeurtenissen op Banda  6 mei 1621 (p2)" />

