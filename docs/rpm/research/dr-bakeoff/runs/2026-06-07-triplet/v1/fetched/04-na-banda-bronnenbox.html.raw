              <div class="field-field-image-item paragraph-image__field-image-item"><div class="media media-image view-mode-max-1300x1300">
  
                <div class="field-image media-image-max-1300x1300__image">
              <div class="field-image-item media-image-max-1300x1300__image-item">    <picture>
